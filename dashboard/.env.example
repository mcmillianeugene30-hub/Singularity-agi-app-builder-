# ========================================
# Singularity AGI Dashboard - Environment Configuration
# ========================================
# Copy this file to .env.local and fill in your values

# Backend API URL
# Set this to your deployed backend URL (Render, Railway, etc.)
NEXT_PUBLIC_API_URL=https://singularity-agi-backend.onrender.com

# Supabase Configuration (for the platform database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
