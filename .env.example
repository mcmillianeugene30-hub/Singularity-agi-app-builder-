# ========================================
# Singularity AGI - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# AI Provider API Keys
# ========================================
# OpenRouter API Key(s) - Supports multiple keys for rotation
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
OPENROUTER_API_KEY_1=sk-or-v1-second-key-here
OPENROUTER_API_KEY_2=sk-or-v1-third-key-here
OPENROUTER_API_KEY_3=sk-or-v1-fourth-key-here

# Groq API Key(s) - Supports multiple keys for rotation
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_API_KEY_1=gsk_second-key-here
GROQ_API_KEY_2=gsk_third-key-here
GROQ_API_KEY_3=gsk_fourth-key-here

# Google Gemini API Key(s) - Supports multiple keys for rotation
GEMINI_API_KEY=AIza-your-gemini-key-here
GEMINI_API_KEY_1=AIza-second-key-here
GEMINI_API_KEY_2=AIza-third-key-here
GEMINI_API_KEY_3=AIza-fourth-key-here

# OpenAI API Key(s) - Future use, not currently used in codebase
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_API_KEY_1=sk-proj-second-key-here
OPENAI_API_KEY_2=sk-proj-third-key-here

# ========================================
# Deployment Platform Tokens
# ========================================
# GitHub Token (required for pushing code)
GITHUB_TOKEN=your_github_token_here

# Netlify Token (for Netlify deployment)
NETLIFY_TOKEN=your_netlify_token_here
NETLIFY_API_KEY=your_netlify_api_key_here

# Railway Token (for Railway deployment)
RAILWAY_TOKEN=your_railway_token_here
RAIL_TOKEN=your_rail_token_here

# Vercel Token (for Vercel deployment)
VERCEL_TOKEN=your_vercel_token_here

# Render API Key (for Render deployment)
RENDER_API_KEY=your_render_api_key_here

# ========================================
# Database Configuration
# ========================================
# Supabase Platform Database (for storing projects and build logs)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Neon Database API Key (for creating branch databases)
NEON_API_KEY=your_neon_api_key_here

# ========================================
# Application Configuration
# ========================================
# Server Configuration
PORT=8000
WORKERS=1
ENVIRONMENT=production

# CORS Configuration (comma-separated list of allowed origins)
# For production, specify exact origins. For development, use *
ALLOWED_ORIGINS=https://singularity-dashboard.vercel.app,https://your-frontend-domain.com

# ========================================
# Optional: Monitoring & Logging
# ========================================
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# Frontend Configuration (for Next.js Dashboard)
# ========================================
# Set this to your deployed backend URL (Render, Railway, etc.)
NEXT_PUBLIC_API_URL=https://singularity-agi-backend.onrender.com

# Supabase for frontend dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
