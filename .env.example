# ========================================
# Singularity AGI - Environment Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========================================
# AI Provider API Keys
# ========================================
# OpenRouter API Key(s) - Supports multiple keys for rotation
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_1=optional_second_key
OPENROUTER_API_KEY_2=optional_third_key

# Groq API Key(s) - Supports multiple keys for rotation
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEY_1=optional_second_key

# Google Gemini API Key(s) - Supports multiple keys for rotation
GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEY_1=optional_second_key
GEMINI_API_KEY_2=optional_third_key

# ========================================
# Deployment Platform Tokens
# ========================================
# GitHub Token (required for pushing code)
GITHUB_TOKEN=your_github_token_here

# Netlify Token (for Netlify deployment)
NETLIFY_TOKEN=your_netlify_token_here
NETLIFY_API_KEY=your_netlify_api_key_here

# Railway Token (for Railway deployment)
RAILWAY_TOKEN=your_railway_token_here
RAIL_TOKEN=your_rail_token_here

# Vercel Token (for Vercel deployment)
VERCEL_TOKEN=your_vercel_token_here

# Render API Key (for Render deployment)
RENDER_API_KEY=your_render_api_key_here

# ========================================
# Database Configuration
# ========================================
# Supabase Platform Database (for storing projects and build logs)
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Neon Database API Key (for creating branch databases)
NEON_API_KEY=your_neon_api_key_here

# ========================================
# Application Configuration
# ========================================
# Server Configuration
PORT=8000
WORKERS=1
ENVIRONMENT=production

# CORS Configuration (comma-separated list of allowed origins)
# For production, specify exact origins. For development, use *
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://another-domain.com

# ========================================
# Optional: Monitoring & Logging
# ========================================
# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ========================================
# Frontend Configuration (for Next.js Dashboard)
# ========================================
NEXT_PUBLIC_API_URL=https://your-backend-api-url.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
