{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install --upgrade pip setuptools wheel && pip install -r requirements.txt",
    "watchPatterns": ["**/*.py", "requirements.txt"]
  },
  "deploy": {
    "startCommand": "gunicorn api:app --workers $WORKERS --worker-class uvicorn.workers.UvicornWorker --bind 0.0.0.0:$PORT --timeout 300 --keepalive 5",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "singularity-agi-backend": {
      "environment": {
        "PYTHONUNBUFFERED": "1",
        "PYTHONDONTWRITEBYTECODE": "1",
        "PORT": "8000",
        "WORKERS": "1",
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "INFO",
        "ALLOWED_ORIGINS": "https://singularity-dashboard.vercel.app",
        "NEXT_PUBLIC_API_URL": "https://singularity-agi-backend.up.railway.app"
      }
    }
  }
}
